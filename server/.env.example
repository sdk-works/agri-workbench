# 首次复制为 .env；已有 .env 请保留。密钥和运行数据不会提交 Git。
PORT=8787
OLLAMA_BASE=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:7b
ZHIPU_API_KEY=

# 独立云端裁判：基础地址包含 /v1 等前缀，不含 /chat/completions。
# 不会沿用旧 JUDGE_MODEL=local2_agri，也不会自动复用回答模型做裁判。
JUDGE_BASE_URL=
JUDGE_CLOUD_MODEL=
JUDGE_API_KEY=
JUDGE_FALLBACK_MODEL=qwen2.5:7b

# 首次从环境变量初始化；在管理员页面保存后，以该文件配置为准。
# MODEL_CONFIG_PATH=/srv/agri/data/model-config.json
# WORKSPACE_DATA_PATH=/srv/agri/data/workspace.sqlite
# UPLOAD_PATH=/srv/agri/uploads
# DATA_PATH=/srv/agri/data/workbench.sqlite

# 设置后使用 PostgreSQL；不要直接切换已有 SQLite，应先停止写入并运行迁移。
# DATABASE_URL=postgresql://agri:password@127.0.0.1:5432/agri
# HTTPS 反向代理部署时设置明确来源及 Secure Cookie。
# ALLOWED_ORIGINS=https://agri.example.com
# COOKIE_SECURE=true
