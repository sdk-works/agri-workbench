# 大体积、可重建、含隐私的内容不进版本库
models/
runtime/
uploads/
data/
backups/
staging/

# 历史备份副本（目录里已积累 200+ 个，靠 git 历史回滚即可）
*.bak
*.bak.*
*.bak_*
app.bak*/
app.bak.*/
dist.bak*/
